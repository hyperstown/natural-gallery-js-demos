{
  "compilerOptions": {
    /** Keep in sync with resolve.alias in vite.config.js */
    "baseUrl": ".",
    "paths": {
      "@assets/*": ["src/assets/*"],
      "@api/*": ["src/lib/api/*"],
      "@lib/*": ["src/lib/*"],
      "@/*": ["src/*"]
    },
    "moduleResolution": "bundler",
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["vite/client"],
    "skipLibCheck": true,
    "checkJs": false
  },
  "include": ["src/**/*.d.ts", "src/**/*.js", "src/**/*.jsx"]
}
