{
  "compilerOptions": {
    /**
     * Keep in sync with resolve.alias in vite.config.js. Relative to this file:
     * `paths` needs no `baseUrl` since TypeScript 4.1, and `baseUrl` itself is
     * deprecated as of 6.0.
     */
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "@api/*": ["./src/lib/api/*"],
      "@lib/*": ["./src/lib/*"],
      "@/*": ["./src/*"]
    },
    "moduleResolution": "bundler",
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["vite/client"],
    "skipLibCheck": true,
    "checkJs": false
  },
  "include": ["src/**/*.d.ts", "src/**/*.js", "src/**/*.jsx"]
}
